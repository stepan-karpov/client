def get_months():
    months = []
    for k, v in MONTH.items():
        months.append(v)
#    print(months)
    return months

def export_dictionary():
    start_time = datetime.datetime.now()
    opts = get_dictionary()

    connection = mysql.connector.connect(
          host="localhost",
          user="root",
          passwd="password",
          database="voice_helper"
        )
    cursor = connection.cursor()

    q = "INSERT INTO voice_helper.opts (dict, request) VALUES (\"" + "main" + "\", \""

    for key, cmd in opts["cmds"].items():
        for r in cmd:
            q += r + ", "
            #cursor.execute(q)
            #connection.commit()
    q = q[:-2] + "\");"
    print(q)
    cursor.execute(q)
    connection.commit()
    print("[ log ] export time: " + str(datetime.datetime.now() - start_time))

def export_dictionary_two():
